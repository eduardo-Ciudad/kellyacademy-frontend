VITE_API_URL=

# Habilita a assistente Júlia na tela de resultado somente quando for "true".
VITE_JULIA_HABILITADA=false

# Só ligue quando o plano Pro estiver aplicado no backend e PAGAMENTO_HABILITADO=true na VPS.
VITE_PAGAMENTO_HABILITADO=false

# ID do GA4; só é usado em produção no domínio kellyacademy.com.br.
VITE_GA_MEASUREMENT_ID=

# Usado somente pelo proxy do Vite durante o desenvolvimento local.
VITE_API_PROXY_TARGET=http://localhost:8080
